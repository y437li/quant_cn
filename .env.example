# Copy to .env (git-ignored) and fill in. Loaded by core.Config (python-dotenv) and by
# `uv run --env-file .env` in the Makefile. Never commit real values.

# Tushare Pro token (https://tushare.pro/user/token). Required for downloads.
TUSHARE_TOKEN=

# Lake root, OUTSIDE the repository (D-021). Overrides config/local.yaml and config/base.yaml.
# This machine: /Volumes/Treasury/quant_cn_lake
QUANT_CN_LAKE_ROOT=
